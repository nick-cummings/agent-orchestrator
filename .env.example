# Copy to .env.local and adjust. Matches infra/docker-compose.yml.
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator

# Realtime pub/sub. Unset → in-memory bus (single-process dev). Set for
# multi-instance / prod so the poller and SSE endpoint share a channel.
REDIS_URL=redis://localhost:6379

# Jules engine (Phase 1 single-user stand-in for Connections/CredentialProvider).
# Get a key from jules.google settings; connect the target repo to the Jules
# GitHub app. JULES_BASE_URL is optional (defaults to the v1alpha endpoint).
JULES_API_KEY=
JULES_BASE_URL=https://jules.googleapis.com/v1alpha

# Guards the poller cron route (/api/poll). Vercel Cron sends it as a Bearer
# token automatically. Unset → the route is open (local dev only).
CRON_SECRET=
